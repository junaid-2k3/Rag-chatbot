---
import Layout from "../layouts/Layout.astro";
import ChatWindow from "../components/ChatWindow.astro";
import ChatInput from "../components/ChatInput.astro";
---

<Layout title="FAST Peshawar Assistant" description="Ask questions about FAST-NUCES Peshawar campus: fees, admissions, hostels and the academic calendar.">
  <main class="app">
    <header class="top">
      <div>
        <h1>FAST-NUCES Peshawar</h1>
        <p>Campus assistant</p>
      </div>
      <button id="theme" class="theme" type="button" aria-label="Dark theme" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </header>
    <ChatWindow />
    <ChatInput />
  </main>
</Layout>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme") as HTMLButtonElement;
  button.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
  button.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    button.setAttribute("aria-pressed", String(next === "dark"));
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* private mode: theme just won't persist */
    }
  });
</script>
